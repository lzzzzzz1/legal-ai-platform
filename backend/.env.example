DASHSCOPE_API_KEY=
APP_ENV=development
REQUIRE_API_AUTH=false
API_AUTH_TOKEN=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-max
BAILIAN_TIMEOUT_SECONDS=120
BAILIAN_MAX_OUTPUT_TOKENS=4096
# Keep this off for OpenAI-compatible local gateways unless their JSON mode is verified.
BAILIAN_RESPONSE_FORMAT=off
BAILIAN_DEEP_REVIEW_TIMEOUT_SECONDS=180
BAILIAN_DEEP_REVIEW_MAX_OUTPUT_TOKENS=5000
BAILIAN_INTAKE_MAX_OUTPUT_TOKENS=2200
BAILIAN_ENABLE_THINKING=false
BAILIAN_EMBEDDING_MODEL=text-embedding-v3
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=legal_laws
LEGAL_LAWS_IMPORT_COLLECTION=legal_laws_v2_1024
QDRANT_API_KEY=
ADMIN_API_TOKEN=
MAX_KNOWLEDGE_SNAPSHOT_BYTES=262144000
KNOWLEDGE_IMPORT_TIMEOUT_SECONDS=300
PDF_PARSE_URL=http://192.168.6.71:30003/v1/pdfparse
PDF_PARSE_TIMEOUT_SECONDS=300
RERANK_URL=http://192.168.6.71:30002/v1/rerank
RERANK_MODEL=Qwen3-Reranker-0.6B
RERANK_TIMEOUT_SECONDS=60
RERANK_ENABLED=true
RERANK_DOCUMENT_MAX_CHARS=1800
RAG_RECALL_K=12
RAG_REQUIRE_EFFECTIVE_LAWS=true
RAG_CACHE_TTL_SECONDS=60
RAG_DEDUPLICATE_RESULTS=true
MAX_CONTRACT_CHARS=40000
REVIEW_SEGMENT_CHARS=18000
REVIEW_REPAIR_TIMEOUT_SECONDS=20
REVIEW_JSON_RETRY_MAX_CONTRACT_CHARS=12000
REVIEW_RULE_FALLBACK_ON_MODEL_ERROR=true
REVIEW_AUDIT_REDACT=true
REVIEW_FEEDBACK_LOG=logs/review_feedback.jsonl
NO_PROXY=localhost,127.0.0.1,192.168.6.71
no_proxy=localhost,127.0.0.1,192.168.6.71
